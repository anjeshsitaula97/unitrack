generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuickFilter {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  icon      String   @default("Filter")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model University {
  id        Int      @id @default(autoincrement())
  name          String
  shortName     String?
  country       String
  city          String?
  type          String        @default("Public")
  email         String?
  phone         String?
  address       String?
  website       String?
  founded       Int?
  accreditation String?
  ranking       Int?
  description   String?
  status        String        @default("Active")
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  banner        String?
  images        String?
  logo          String?
  requirements  String?
  partnerId     Int?
  partner       Partner?      @relation(fields: [partnerId], references: [id])
  partnershipAmount Float?
  commissionType    String?    @default("Percentage") // "Percentage" or "Flat"
  commissionValue   Float?
  commissionCurrency String?
  applications  Application[]
  courses       Course[]
}

model Partner {
  id        Int      @id @default(autoincrement())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  description   String?
  countries     String?       @default("[]") // JSON array of country names
  universities  University[]
  students      Student[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Course {
  id        Int      @id @default(autoincrement())
  name                  String
  universityId          Int
  faculty               String
  degreeType            String
  level                 String
  credits               Int
  duration              String
  enrolled              Int           @default(0)
  status                String        @default("Active")
  isFeatured            Boolean       @default(false)
  startDate             DateTime?
  color                 String        @default("#6366f1")
  initials              String
  instructor            String
  description           String
  prerequisites         String
  intake                String?
  language              String        @default("English")
  mode                  String        @default("Online")
  academicRequirement   String?
  percentageRequired    String?
  gpaRequired           String?
  englishLanguageType   String        @default("IELTS")
  englishOverallScore   String?
  englishReadingScore   String?
  englishWritingScore   String?
  englishListeningScore String?
  englishSpeakingScore  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  courseCode            String?
  currency              String?
  tuitionFee            String?
  applicationFee        String?
  applicationFeeCurrency String?
  quickFilters          String?
  requirements          String?
  applicationDeadline   DateTime?
  englishTests          String?
  commissionType        String?    @default("Percentage") // "Percentage" or "Flat"
  commissionValue       Float?
  commissionCurrency    String?
  applications          Application[]
  university            University    @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([faculty])
  @@index([degreeType])
  @@index([level])
  @@index([status])
}

model Faculty {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model DegreeType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Intake {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name                String
  email               String        @unique
  password            String?
  role                String        @default("Viewer")
  status              String        @default("Active")
  avatar              String?
  lastLogin           String        @default("Never")
  lastSeenAt          DateTime?
  isFirstLogin        Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  subscriptionPackage String?       @default("Basic")
  subscriptionExpiry  DateTime?
  loginLogs           LoginLog[]
  activities          ActivityLog[]
  tasks               Task[]
  tickets             Ticket[]
  chatRooms           ChatRoom[]          @relation("ChatRoomMembers")
  chatMessages        ChatMessage[]
  branch              Branch?             @relation(fields: [branchId], references: [id])
  branchId            Int?
  department          Department?         @relation(fields: [departmentId], references: [id])
  departmentId        Int?
  headedDepartment    Department?         @relation("DepartmentHead")
  designationId       Int?
  designation         Designation?        @relation(fields: [designationId], references: [id])
  employeeId          String?             @unique
  phone               String?
  alternatePhone      String?
  dateOfBirth         String?
  gender              String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  emergencyContact    String?
  emergencyPhone      String?
  bankName            String?
  bankAccount         String?
  bankIfsc            String?
  panNumber           String?
  basicSalary         Float?              @default(0)
  hireDate            String?
  employmentType      String?             @default("Full-Time")
  attendances         Attendance[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  approvedLeaves      LeaveRequest[]      @relation("ApprovedLeaves")
  payrolls            Payroll[]
  documents           EmployeeDocument[]
  scannedDocuments    ScannedDocument[]
  fileFolders         FileFolder[]
  fileItems           FileItem[]
  faceDescriptor      String?
  studentConversations StudentConversation[]
  applicationNotes     ApplicationNote[]
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  name      String
  tokenHash String   @unique
  created   DateTime @default(now())
  lastUsed  String   @default("Never")
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemSettings {
  id              Int      @id @default(autoincrement())
  country         String   @default("Nepal")
  currencyCode    String   @default("NPR")
  phoneCode       String   @default("+977")
  language        String   @default("English")
  enableBranches  Boolean  @default(false)
  showBSDate      Boolean  @default(false)
  officeLatitude  Float?
  officeLongitude Float?
  officeRadius    Float?   @default(100)
  enabledModules  String   @default("[]")
  applicationStatuses String @default("[]")
  updatedAt       DateTime @updatedAt
}

model Branch {
  id        Int      @id @default(autoincrement())
  name         String
  location     String?
  manager      String?
  phone        String?
  email        String?
  status       String        @default("Active")
  logo         String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]
  emailSetting EmailSetting?
  users        User[]
}

model EmailSetting {
  id        Int      @id @default(autoincrement())
  type           String   @default("Global") // "Global" or "Branch"
  branchId       Int?     @unique
  smtpHost       String
  smtpPort       Int      @default(587)
  smtpUser       String
  smtpPass       String
  smtpEncryption String   @default("TLS") // TLS, SSL, None
  fromEmail      String
  fromName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Lead {
  id        Int      @id @default(autoincrement())
  name              String
  email             String    @unique
  phone             String?
  source            String?   @default("Website")
  status            String    @default("New")
  notes             String?
  uploadedBy        String?
  uploaderNotes     String?
  counselor         String?
  counselorNotes    String?
  assignedDate      DateTime?
  nextFollowUp      DateTime?
  interestedCountry String?
  maritalStatus     String?   @default("Single")
  childrenCount     Int?      @default(0)
  referenceName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Role {
  id        Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String
  color       String?  @default("text-slate-600 bg-slate-50 border-slate-200")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  actorName     String
  actorInitials String?
  actorColor    String?
  action        String
  target        String
  targetBy      String?
  details       String?
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String?
  title     String
  message   String
  type      String   @default("Info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Student {
  id                    Int               @id @default(autoincrement())
  name                  String
  firstName             String?
  lastName              String?
  email                 String            @unique
  admissionEmail        String?
  studentPassword       String?
  phone                 String?
  whatsappNumber        String?
  gender                String?
  dob                   String?
  dobAd                 String?
  dobBs                 String?
  nationality           String?
  maritalStatus         String?
  photoUrl              String?
  address               String?
  permanentProvince     String?
  permanentDistrict     String?
  permanentMunicipality String?
  permanentWardNo       String?
  permanentAddress      String?
  temporaryProvince     String?
  temporaryDistrict     String?
  temporaryMunicipality String?
  temporaryWardNo       String?
  temporaryAddress      String?
  passportNumber        String?
  passportNationality   String?
  passportIssueDate     String?
  passportExpiryDate    String?
  passportIssuePlace    String?
  education             String?
  workExperience        String?
  training              String?
  testType              String?
  overallScore          String?
  readingScore          String?
  writingScore          String?
  listeningScore        String?
  speakingScore         String?
  moi                   String?
  testDate              String?
  testRegNumber         String?
  studyLevel            String?
  intakeTerm            String?
  major                 String?
  interestedCountry     String?
  partnerId             Int?
  partner               Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  targetUniversities    String?
  spouseName            String?
  childrenDetails       String?           @default("[]")
  guardianName          String?
  guardianPhone         String?
  guardianEmail         String?
  guardianRelation      String?
  guardianAddress       String?
  status                String            @default("New Leads")
  statusColor           String?
  initials              String?
  color                 String?
  university            String?
  country               String?
  lastActivity          String?
  counselor             String?
  lead                  String?
  branchId              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  applications          Application[]
  payments              Payment[]
  documents             StudentDocument[]
  conversations         StudentConversation[]
}

model Application {
  id           Int        @id @default(autoincrement())
  studentId    Int
  universityId Int
  courseId     Int
  status       String     @default("Submitted")
  appliedDate  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workflowStages ApplicationWorkflowStage[]
  notes           ApplicationNote[]

  @@index([studentId])
  @@index([universityId])
  @@index([courseId])
}

model ApplicationNote {
  id        Int      @id @default(autoincrement())
  applicationId Int
  content       String
  authorId      Int?
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ApplicationWorkflowStage {
  id           Int      @id @default(autoincrement())
  applicationId Int
  name         String
  order        Int
  description  String?
  subtasks     String   @default("[]") // JSON array of {id, title, done}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model StudentDocument {
  id        Int      @id @default(autoincrement())
  studentId          Int
  type               String?
  name               String
  url                String
  status             String?          @default("Uploaded")
  fileSize           Int?
  fileType           String?
  academicDocumentId Int?
  uploadedAt         DateTime         @default(now())
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicDocument   AcademicDocument? @relation(fields: [academicDocumentId], references: [id])

  @@index([studentId])
  @@index([academicDocumentId])
}

model Qualification {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model AcademicDocument {
  id        Int      @id @default(autoincrement())
  name      String           @unique
  createdAt DateTime         @default(now())
  files     FileItem[]
  studentDocuments StudentDocument[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  studentId   Int
  amount      Float
  currency    String   @default("NPR")
  status      String   @default("Pending")
  method      String?
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  proofUrl    String?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Expense {
  id        Int      @id @default(autoincrement())
  category      String
  amount        Float
  currency      String   @default("NPR")
  date          DateTime @default(now())
  description   String?
  paidTo        String?
  method        String?
  billNo        String?
  transactionNo String?
  screenshot    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Task {
  id        Int      @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("Todo")
  priority    String    @default("Medium")
  dueDate     DateTime?
  type        String    @default("Manual")
  country     String?
  visaType    String?
  assigneeId  Int?
  branchId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch?   @relation(fields: [branchId], references: [id])
  assignee    User?     @relation(fields: [assigneeId], references: [id])
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String             @unique
  code      String?
  createdAt DateTime           @default(now())
  resources LearningResource[]
}

model LearningCategory {
  id        Int      @id @default(autoincrement())
  name      String             @unique
  createdAt DateTime           @default(now())
  resources LearningResource[]
}

model LearningResource {
  id        Int      @id @default(autoincrement())
  title       String
  description String?
  type        String            @default("Document")
  url         String
  thumbnail   String?
  fileSize    String?
  countryId   Int?
  categoryId  Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    LearningCategory? @relation(fields: [categoryId], references: [id])
  country     Country?          @relation(fields: [countryId], references: [id])
}

model Ticket {
  id        Int      @id @default(autoincrement())
  title       String
  description String
  type        String   @default("Technical") // Technical (Bug) or Feature Request
  priority    String   @default("Medium") // Low, Medium, High, Urgent
  status      String   @default("Open") // Open, In Progress, Resolved, Closed
  creatorId   Int
  creator     User     @relation(fields: [creatorId], references: [id])
  screenshot  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
}

model VisaType {
  id        Int      @id @default(autoincrement())
  label       String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model EmbassyDetail {
  id        Int      @id @default(autoincrement())
  country     String
  visaType    String
  name        String
  address     String?
  phone       String?
  email       String?
  website     String?
  workingHours String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisaChecklist {
  id        Int      @id @default(autoincrement())
  country     String
  visaType    String
  title       String
  description String?
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowStage {
  id        Int      @id @default(autoincrement())
  country     String
  visaType    String
  name        String
  order       Int
  description String?
  subtasks    String   @default("[]") // JSON array of {id, title, done}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id        Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  headId      Int?     @unique
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     User[]
}

model Designation {
  id        Int      @id @default(autoincrement())
  title       String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     User[]
}

model EmployeeDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String?
  name      String
  url       String
  status    String   @default("Uploaded")
  fileSize  Int?
  fileType  String?
  createdAt DateTime @default(now())
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  status        String   @default("Present")
  notes         String?
  checkInPhoto  String?
  checkOutPhoto String?
  checkInLat    Float?
  checkInLng    Float?
  checkOutLat   Float?
  checkOutLng   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model LeaveType {
  id        Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  daysPerYear Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  balances    LeaveBalance[]
  requests    LeaveRequest[]
}

model LeaveBalance {
  id        Int      @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  totalDays   Int       @default(0)
  usedDays    Int       @default(0)
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
}

model LeaveRequest {
  id        Int      @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("Pending")
  approvedBy  Int?
  approver    User?     @relation("ApprovedLeaves", fields: [approvedBy], references: [id])
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Payroll {
  id        Int      @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  basicSalary   Float          @default(0)
  allowances    Float          @default(0)
  deductions    Float          @default(0)
  bonus         Float          @default(0)
  netSalary     Float          @default(0)
  status        String         @default("Draft")
  paidAt        DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PayrollItem[]

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month, year])
}

model PayrollItem {
  id        Int      @id @default(autoincrement())
  payrollId Int
  payroll   Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  label     String
  type      String
  amount    Float    @default(0)
  createdAt DateTime @default(now())

  @@index([payrollId])
}

model ScannedDocument {
  id        Int      @id @default(autoincrement())
  userId     Int
  filename   String
  url        String
  fileSize   Int
  dpi        Int      @default(200)
  pageCount  Int      @default(1)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model FileFolder {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  files     FileItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FileItem {
  id        Int      @id @default(autoincrement())
  name               String
  url                String
  fileSize           Int              @default(0)
  fileType           String           @default("application/octet-stream")
  academicDocumentId Int?
  folderId           Int
  userId             Int
  createdAt          DateTime         @default(now())
  folder             FileFolder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicDocument   AcademicDocument? @relation(fields: [academicDocumentId], references: [id])

  @@index([folderId])
  @@index([userId])
  @@index([academicDocumentId])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  type      String   @default("Public") // Public, Optional, Company
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
}

model ChatRoom {
  id        Int      @id @default(autoincrement())
  name      String?
  type      String        @default("DIRECT")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  members   User[]        @relation("ChatRoomMembers")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
}

model TrashItem {
  id        Int      @id @default(autoincrement())
  entityType String
  entityId   String
  entityName String
  deletedAt  DateTime  @default(now())
  expiresAt  DateTime
  restoredAt DateTime?
  deletedBy  String?
  createdAt  DateTime  @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([expiresAt])
}

model SavedReport {
  id        Int      @id @default(autoincrement())
  name        String
  description String?
  type        String   @default("tabular")
  config      String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DashboardLayout {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  layout    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model OnboardingProgress {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  step      Int      @default(1)
  completed Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComparisonList {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String   @default("My Comparison")
  items     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model StudentConversation {
  id        Int      @id @default(autoincrement())
  studentId  Int
  staffId    Int
  subject    String?
  lastMessage String?
  lastMessageAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   StudentMessage[]
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff      User             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([studentId, staffId])
  @@index([studentId])
  @@index([staffId])
}

model StudentMessage {
  id        Int      @id @default(autoincrement())
  conversationId Int
  senderId       String
  content        String
  read           Boolean            @default(false)
  createdAt      DateTime           @default(now())
  conversation   StudentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model RateLimitLog {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}
