generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model QuickFilter {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  label         String
  icon          String   @default("Filter")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([consultancyId, label])
  @@index([consultancyId])
}

model University {
  consultancyId      Int?
  id                 Int           @id @default(autoincrement())
  name               String
  shortName          String?
  country            String
  city               String?
  type               String        @default("Public")
  email              String?
  phone              String?
  address            String?
  website            String?
  // Direct application/apply URL for the university. Platform-only: it is
  // visible to Super Admins and hidden from consultancy users.
  applicationLink    String?
  founded            Int?
  accreditation      String?       @db.LongText
  ranking            Int?
  description        String?
  status             String        @default("Active")
  isFeatured         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  banner             String?
  images             String?       @db.LongText
  logo               String?
  requirements       String?       @db.LongText
  partnerId          Int?
  partner            Partner?      @relation(fields: [partnerId], references: [id])
  partnershipAmount  Float?
  commissionType     String?       @default("Percentage") // "Percentage" or "Flat"
  commissionValue    Float?
  commissionCurrency String?
  applications       Application[]
  courses            Course[]

  @@index([consultancyId])
}

model Partner {
  consultancyId Int?
  id            Int          @id @default(autoincrement())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  description   String?
  countries     String?      @default("[]") @db.LongText // JSON array of country names
  universities  University[]
  students      Student[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([consultancyId])
}

model Course {
  consultancyId          Int?
  id                     Int           @id @default(autoincrement())
  name                   String
  universityId           Int
  faculty                String
  degreeType             String
  level                  String
  credits                Decimal           @db.Decimal(6, 2)
  duration               String
  enrolled               Int           @default(0)
  status                 String        @default("Active")
  isFeatured             Boolean       @default(false)
  startDate              DateTime?
  color                  String        @default("#6366f1")
  initials               String
  instructor             String
  instructorEmail        String?
  description            String        @db.LongText
  prerequisites          String        @db.LongText
  intake                 String?       @db.LongText
  language               String        @default("English")
  mode                   String        @default("Online")
  academicRequirement    String?       @db.LongText
  percentageRequired     String?
  gpaRequired            String?
  englishLanguageType    String        @default("IELTS")
  englishOverallScore    String?
  englishReadingScore    String?
  englishWritingScore    String?
  englishListeningScore  String?
  englishSpeakingScore   String?
  englishTestStage       String?       @default("Before Application") // "Before Application" or "After Application"
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  courseCode             String?
  currency               String?
  tuitionFee             String?
  tuitionFeePeriod       String?       @default("Year") // "Year" or "Semester"
  applicationFee         String?
  applicationFeeCurrency String?
  /// A deposit payable on enrolment, distinct from the application fee.
  depositFee             String?
  depositFeeCurrency     String?
  /// Whether the deposit is returned to the student. A non-refundable deposit
  /// is forfeited if the student withdraws.
  depositFeeRefundable   Boolean           @default(false)
  quickFilters           String?       @db.LongText
  requirements           String?       @db.LongText
  applicationDeadline    DateTime?
  englishTests           String?       @db.LongText
  commissionType         String?       @default("Percentage") // "Percentage" or "Flat"
  commissionValue        Float?
  commissionCurrency     String?
  applications           Application[]
  university             University    @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([faculty])
  @@index([degreeType])
  @@index([level])
  @@index([status])
  @@index([consultancyId])
}

model Faculty {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  name          String
  createdAt     DateTime @default(now())

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model DegreeType {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  name          String
  createdAt     DateTime @default(now())

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model Intake {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  name          String
  createdAt     DateTime @default(now())

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model User {
  consultancyId             Int?
  id                        Int                   @id @default(autoincrement())
  name                      String
  email                     String                @unique
  password                  String?
  role                      String                @default("Viewer")
  status                    String                @default("Active")
  avatar                    String?
  lastLogin                 String                @default("Never")
  lastSeenAt                DateTime?
  activeSessionId           String?
  activeSessionAt           DateTime?
  activeSessionIp           String?
  activeSessionUserAgent    String?
  isFirstLogin              Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  subscriptionPackage       String?               @default("Basic")
  subscriptionExpiry        DateTime?
  loginLogs                 LoginLog[]
  activities                ActivityLog[]
  tasks                     Task[]
  tickets                   Ticket[]
  chatRooms                 ChatRoom[]            @relation("ChatRoomMembers")
  chatMessages              ChatMessage[]
  branch                    Branch?               @relation(fields: [branchId], references: [id])
  branchId                  Int?
  department                Department?           @relation(fields: [departmentId], references: [id])
  departmentId              Int?
  headedDepartment          Department?           @relation("DepartmentHead")
  designationId             Int?
  designation               Designation?          @relation(fields: [designationId], references: [id])
  employeeId                String?               @unique
  phone                     String?
  alternatePhone            String?
  dateOfBirth               String?
  gender                    String?
  address                   String?
  city                      String?
  state                     String?
  zipCode                   String?
  country                   String?
  emergencyContact          String?
  emergencyPhone            String?
  bankName                  String?
  bankAccount               String?
  bankIfsc                  String?
  panNumber                 String?
  basicSalary               Float?                @default(0)
  hireDate                  String?
  employmentType            String?               @default("Full-Time")
  attendances               Attendance[]
  leaveBalances             LeaveBalance[]
  leaveRequests             LeaveRequest[]
  approvedLeaves            LeaveRequest[]        @relation("ApprovedLeaves")
  payrolls                  Payroll[]
  documents                 EmployeeDocument[]
  scannedDocuments          ScannedDocument[]
  fileFolders               FileFolder[]
  fileItems                 FileItem[]
  faceDescriptor            String?
  studentConversations      StudentConversation[]
  applicationNotes          ApplicationNote[]
  marketingRequests         MarketingRequest[]    @relation("MarketingRequestRequester")
  news                      News[]
  newsReads                 NewsRead[]
  assignedMarketingRequests MarketingRequest[]    @relation("MarketingRequestAssignee")
  uploadedMaterials         MarketingMaterial[]   @relation("MarketingMaterialUploader")

  @@index([consultancyId])
}

model LoginLog {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([consultancyId])
}

model ApiKey {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  name          String
  tokenHash     String   @unique
  created       DateTime @default(now())
  lastUsed      String   @default("Never")
  createdAt     DateTime @default(now())

  @@index([consultancyId])
}

model PasswordResetToken {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  email         String
  /// SHA-256 digest of the secret. The plaintext OTP or reset token is never
  /// stored, so a leaked database row cannot be replayed as a credential.
  tokenHash     String
  expiresAt     DateTime
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([consultancyId])
  @@index([email])
  @@index([tokenHash])
}

model SystemSettings {
  consultancyId       Int?
  id                  Int      @id @default(autoincrement())
  country             String   @default("Nepal")
  currencyCode        String   @default("NPR")
  phoneCode           String   @default("+977")
  language            String   @default("English")
  enableBranches      Boolean  @default(false)
  showBSDate          Boolean  @default(false)
  officeLatitude      Float?
  officeLongitude     Float?
  officeRadius        Float?   @default(100)
  enabledModules      String   @default("[]")
  applicationStatuses String   @default("[]")
  showNewsOnLogin     Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@index([consultancyId])
}

model Branch {
  consultancyId Int?
  id            Int           @id @default(autoincrement())
  name          String
  location      String?
  manager       String?
  phone         String?
  email         String?
  status        String        @default("Active")
  logo          String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tasks         Task[]
  emailSetting  EmailSetting?
  users         User[]

  @@index([consultancyId])
}

model EmailSetting {
  consultancyId  Int?
  id             Int      @id @default(autoincrement())
  type           String   @default("Global") // "Global" or "Branch"
  branchId       Int?     @unique
  smtpHost       String
  smtpPort       Int      @default(587)
  smtpUser       String
  smtpPass       String
  smtpEncryption String   @default("TLS") // TLS, SSL, None
  fromEmail      String
  fromName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([consultancyId])
}

// Editable email bodies keyed by a stable machine name (e.g. "student-updated").
// Rows are seeded from the built-in catalog the first time Settings > Email
// Templates loads; a missing or disabled row falls back to the built-in default
// so a template can never blank out an automated email.
model EmailTemplate {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  key           String
  name          String
  subject       String
  body          String   @db.LongText
  isEnabled     Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([consultancyId, key])
  @@index([consultancyId])
}

// Internal announcement/news posts. A row with a null consultancyId (created
// under platform scope by a Super Admin) is visible to every consultancy;
// otherwise the row belongs to one consultancy. Reads are tracked per user so
// the login popup only surfaces news the user has not dismissed yet.
model News {
  consultancyId Int?
  id            Int        @id @default(autoincrement())
  title         String
  body          String     @db.LongText
  audience      String     @default("consultancy") // "all" (platform-wide) or "consultancy"
  isPublished   Boolean    @default(true)
  publishedAt   DateTime?
  authorId      Int?
  author        User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reads         NewsRead[]

  @@index([consultancyId])
}

model NewsRead {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  newsId        Int
  userId        Int
  readAt        DateTime @default(now())
  news          News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@index([consultancyId])
  @@index([userId])
}

model Lead {
  consultancyId     Int?
  id                Int       @id @default(autoincrement())
  name              String
  email             String
  phone             String?
  source            String?   @default("Website")
  status            String    @default("New")
  notes             String?
  uploadedBy        String?
  uploaderNotes     String?
  counselor         String?
  counselorNotes    String?
  assignedDate      DateTime?
  nextFollowUp      DateTime?
  interestedCountry String?
  maritalStatus     String?   @default("Single")
  childrenCount     Int?      @default(0)
  referenceName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([consultancyId, email])
  @@index([consultancyId])
}

model Role {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  permissions   String   @db.LongText
  color         String?  @default("text-slate-600 bg-slate-50 border-slate-200")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model ActivityLog {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  actorName     String
  actorInitials String?
  actorColor    String?
  action        String
  target        String
  targetBy      String?
  details       String?
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  @@index([consultancyId])
}

model Notification {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  userId        String?
  title         String
  message       String
  type          String   @default("Info")
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([consultancyId])
}

model Student {
  consultancyId            Int?
  id                       Int                   @id @default(autoincrement())
  name                     String
  firstName                String?
  lastName                 String?
  email                    String                @unique
  admissionEmail           String?
  studentPassword          String?
  // Plaintext password for the admission (application) email. This is a shared
  // credential shown back to staff in the student detail view, unlike
  // studentPassword which is a bcrypt hash for the student portal login.
  applicationEmailPassword String?
  phone                    String?
  whatsappNumber           String?
  gender                   String?
  dob                      String?
  dobAd                    String?
  dobBs                    String?
  nationality              String?
  maritalStatus            String?
  photoUrl                 String?
  address                  String?
  permanentProvince        String?
  permanentDistrict        String?
  permanentMunicipality    String?
  permanentWardNo          String?
  permanentAddress         String?
  temporaryProvince        String?
  temporaryDistrict        String?
  temporaryMunicipality    String?
  temporaryWardNo          String?
  temporaryAddress         String?
  passportNumber           String?
  passportNationality      String?
  passportIssueDate        String?
  passportExpiryDate       String?
  passportIssuePlace       String?
  // These hold JSON arrays written by the form. A bare String? maps to
  // VARCHAR(191) on MySQL, which silently truncated longer histories and left
  // unparseable values behind, so they are explicitly LONGTEXT.
  education                String?               @db.LongText
  workExperience           String?               @db.LongText
  training                 String?               @db.LongText
  testType                 String?
  overallScore             String?
  readingScore             String?
  writingScore             String?
  listeningScore           String?
  speakingScore            String?
  moi                      String?
  testDate                 String?
  testRegNumber            String?
  studyLevel               String?
  intakeTerm               String?
  major                    String?
  interestedCountry        String?
  partnerId                Int?
  partner                  Partner?              @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  targetUniversities       String?               @db.LongText
  spouseName               String?
  childrenDetails          String?               @default("[]") @db.LongText
  guardianName             String?
  guardianPhone            String?
  guardianEmail            String?
  guardianRelation         String?
  guardianAddress          String?
  // Additional guardians beyond the primary one, stored as a JSON array
  // (LONGTEXT for the same truncation reason as the other list fields above).
  otherGuardians           String?               @default("[]") @db.LongText
  status                   String                @default("New Leads")
  statusColor              String?
  initials                 String?
  color                    String?
  university               String?
  country                  String?
  lastActivity             String?
  counselor                String?
  lead                     String?
  branchId                 Int?
  activeSessionId          String?
  activeSessionAt          DateTime?
  activeSessionIp          String?
  activeSessionUserAgent   String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  applications             Application[]
  payments                 Payment[]
  documents                StudentDocument[]
  conversations            StudentConversation[]
  notes                    StudentNote[]

  @@index([consultancyId])
}

model Application {
  consultancyId  Int?
  id             Int                        @id @default(autoincrement())
  studentId      Int
  universityId   Int
  courseId       Int
  status         String                     @default("Submitted")
  appliedDate    DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  course         Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  university     University                 @relation(fields: [universityId], references: [id], onDelete: Cascade)
  student        Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workflowStages ApplicationWorkflowStage[]
  notes          ApplicationNote[]

  @@index([studentId])
  @@index([universityId])
  @@index([courseId])
  @@index([consultancyId])
}

model ApplicationNote {
  consultancyId Int?
  id            Int         @id @default(autoincrement())
  applicationId Int
  content       String
  authorId      Int?
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([consultancyId])
}

model ApplicationWorkflowStage {
  consultancyId Int?
  id            Int         @id @default(autoincrement())
  applicationId Int
  name          String
  order         Int
  description   String?
  subtasks      String      @default("[]") // JSON array of {id, title, done}
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([consultancyId])
}

model StudentDocument {
  consultancyId      Int?
  id                 Int               @id @default(autoincrement())
  studentId          Int
  type               String?
  name               String
  url                String
  status             String?           @default("Uploaded")
  fileSize           Int?
  fileType           String?
  academicDocumentId Int?
  uploadedAt         DateTime          @default(now())
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicDocument   AcademicDocument? @relation(fields: [academicDocumentId], references: [id])

  @@index([studentId])
  @@index([academicDocumentId])
  @@index([consultancyId])
}

model Qualification {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  name          String
  level         Int      @default(0) // 1=SEE/SLC/Grade10, 2=+2/PCL/Grade12, 3=Bachelor, 4=Master, 5=PhD
  createdAt     DateTime @default(now())

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model AcademicDocument {
  consultancyId    Int?
  id               Int               @id @default(autoincrement())
  name             String
  createdAt        DateTime          @default(now())
  files            FileItem[]
  studentDocuments StudentDocument[]

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model Payment {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  studentId     Int
  amount        Float
  currency      String   @default("NPR")
  status        String   @default("Pending")
  method        String?
  date          DateTime @default(now())
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  proofUrl      String?
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([consultancyId])
}

model Expense {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  category      String
  amount        Float
  currency      String   @default("NPR")
  date          DateTime @default(now())
  description   String?
  paidTo        String?
  method        String?
  billNo        String?
  transactionNo String?
  screenshot    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([consultancyId])
}

model Task {
  consultancyId Int?
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  status        String    @default("Todo")
  priority      String    @default("Medium")
  dueDate       DateTime?
  type          String    @default("Manual")
  country       String?
  visaType      String?
  assigneeId    Int?
  branchId      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  branch        Branch?   @relation(fields: [branchId], references: [id])
  assignee      User?     @relation(fields: [assigneeId], references: [id])

  @@index([consultancyId])
}

model Country {
  consultancyId Int?
  id            Int                @id @default(autoincrement())
  name          String
  code          String?
  createdAt     DateTime           @default(now())
  resources     LearningResource[]

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model LearningCategory {
  consultancyId Int?
  id            Int                @id @default(autoincrement())
  name          String
  createdAt     DateTime           @default(now())
  resources     LearningResource[]

  @@unique([consultancyId, name])
  @@index([consultancyId])
}

model LearningResource {
  consultancyId Int?
  id            Int               @id @default(autoincrement())
  title         String
  description   String?
  type          String            @default("Document")
  url           String
  thumbnail     String?
  fileSize      String?
  countryId     Int?
  categoryId    Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  category      LearningCategory? @relation(fields: [categoryId], references: [id])
  country       Country?          @relation(fields: [countryId], references: [id])

  @@index([consultancyId])
}

model Ticket {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  type          String   @default("Technical") // Technical (Bug) or Feature Request
  priority      String   @default("Medium") // Low, Medium, High, Urgent
  status        String   @default("Open") // Open, In Progress, Resolved, Closed
  creatorId     Int
  creator       User     @relation(fields: [creatorId], references: [id])
  screenshot    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([creatorId])
  @@index([consultancyId])
}

model VisaType {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  label         String
  description   String?
  createdAt     DateTime @default(now())

  @@unique([consultancyId, label])
  @@index([consultancyId])
}

model EmbassyDetail {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  country       String
  visaType      String
  name          String
  address       String?
  phone         String?
  email         String?
  website       String?
  workingHours  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([consultancyId])
}

model VisaChecklist {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  country       String
  visaType      String
  title         String
  description   String?
  isRequired    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([consultancyId])
}

model WorkflowStage {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  country       String
  visaType      String
  name          String
  order         Int
  description   String?
  subtasks      String   @default("[]") // JSON array of {id, title, done}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([consultancyId])
}

model Department {
  consultancyId Int?
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  headId        Int?     @unique
  head          User?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       User[]

