generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuickFilter {
  id        String   @id @default(cuid())
  label     String   @unique
  icon      String   @default("Filter")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model University {
  id            String        @id @default(cuid())
  name          String
  shortName     String?
  country       String
  city          String?
  type          String        @default("Public")
  email         String?
  phone         String?
  address       String?
  website       String?
  founded       Int?
  accreditation String?
  ranking       Int?
  description   String?
  status        String        @default("Active")
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  banner        String?
  images        String?
  logo          String?
  requirements  String?
  partnerId     String?
  partner       Partner?      @relation(fields: [partnerId], references: [id])
  partnershipAmount Float?
  commissionType    String?    @default("Percentage") // "Percentage" or "Flat"
  commissionValue   Float?
  commissionCurrency String?
  applications  Application[]
  courses       Course[]
}

model Partner {
  id            String        @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  description   String?
  universities  University[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Course {
  id                    String        @id @default(cuid())
  name                  String
  universityId          String
  faculty               String
  degreeType            String
  level                 String
  credits               Int
  duration              String
  enrolled              Int           @default(0)
  status                String        @default("Active")
  isFeatured            Boolean       @default(false)
  startDate             DateTime?
  color                 String        @default("#6366f1")
  initials              String
  instructor            String
  description           String
  prerequisites         String
  intake                String?
  language              String        @default("English")
  mode                  String        @default("Online")
  academicRequirement   String?
  percentageRequired    String?
  gpaRequired           String?
  englishLanguageType   String        @default("IELTS")
  englishOverallScore   String?
  englishReadingScore   String?
  englishWritingScore   String?
  englishListeningScore String?
  englishSpeakingScore  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  courseCode            String?
  currency              String?
  tuitionFee            String?
  applicationFee        String?
  applicationFeeCurrency String?
  quickFilters          String?
  requirements          String?
  applicationDeadline   DateTime?
  englishTests          String?
  applications          Application[]
  university            University    @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([faculty])
  @@index([degreeType])
  @@index([level])
  @@index([status])
}

model Faculty {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model DegreeType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Intake {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  password            String?
  role                String        @default("Viewer")
  status              String        @default("Active")
  avatar              String?
  lastLogin           String        @default("Never")
  lastSeenAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  subscriptionPackage String?       @default("Basic")
  subscriptionExpiry  DateTime?
  loginLogs           LoginLog[]
  activities          ActivityLog[]
  tasks               Task[]
  tickets             Ticket[]
  chatRooms           ChatRoom[]          @relation("ChatRoomMembers")
  chatMessages        ChatMessage[]
  branch              Branch?             @relation(fields: [branchId], references: [id])
  branchId            String?
  department          Department?         @relation(fields: [departmentId], references: [id])
  departmentId        String?
  headedDepartment    Department?         @relation("DepartmentHead")
  designationId       String?
  designation         Designation?        @relation(fields: [designationId], references: [id])
  employeeId          String?             @unique
  phone               String?
  alternatePhone      String?
  dateOfBirth         String?
  gender              String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  emergencyContact    String?
  emergencyPhone      String?
  bankName            String?
  bankAccount         String?
  bankIfsc            String?
  panNumber           String?
  basicSalary         Float?              @default(0)
  hireDate            String?
  employmentType      String?             @default("Full-Time")
  attendances         Attendance[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  approvedLeaves      LeaveRequest[]      @relation("ApprovedLeaves")
  payrolls            Payroll[]
  documents           EmployeeDocument[]
  scannedDocuments    ScannedDocument[]
  fileFolders         FileFolder[]
  fileItems           FileItem[]
  faceDescriptor      String?
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  tokenHash String   @unique
  created   DateTime @default(now())
  lastUsed  String   @default("Never")
  createdAt DateTime @default(now())
}

model SystemSettings {
  id              String   @id @default("system-config")
  country         String   @default("United States")
  currencyCode    String   @default("USD")
  phoneCode       String   @default("+1")
  language        String   @default("English")
  enableBranches  Boolean  @default(false)
  officeLatitude  Float?
  officeLongitude Float?
  officeRadius    Float?   @default(100)
  updatedAt       DateTime @updatedAt
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  location     String?
  manager      String?
  phone        String?
  email        String?
  status       String        @default("Active")
  latitude     Float?
  longitude    Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        Task[]
  emailSetting EmailSetting?
  users        User[]
}

model EmailSetting {
  id             String   @id @default(cuid())
  type           String   @default("Global") // "Global" or "Branch"
  branchId       String?  @unique
  smtpHost       String
  smtpPort       Int      @default(587)
  smtpUser       String
  smtpPass       String
  smtpEncryption String   @default("TLS") // TLS, SSL, None
  fromEmail      String
  fromName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Lead {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  phone             String?
  source            String?   @default("Website")
  status            String    @default("New")
  notes             String?
  uploadedBy        String?
  uploaderNotes     String?
  counselor         String?
  counselorNotes    String?
  assignedDate      DateTime?
  nextFollowUp      DateTime?
  interestedCountry String?
  maritalStatus     String?   @default("Single")
  childrenCount     Int?      @default(0)
  referenceName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @default("[]")
  color       String?  @default("text-slate-600 bg-slate-50 border-slate-200")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id            String   @id @default(cuid())
  actorName     String
  actorInitials String?
  actorColor    String?
  action        String
  target        String
  targetBy      String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String   @default("Info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Student {
  id                    String            @id @default(cuid())
  name                  String
  firstName             String?
  lastName              String?
  email                 String            @unique
  admissionEmail        String?
  studentPassword       String?
  phone                 String?
  whatsappNumber        String?
  gender                String?
  dob                   String?
  dobAd                 String?
  dobBs                 String?
  nationality           String?
  maritalStatus         String?
  photoUrl              String?
  address               String?
  permanentProvince     String?
  permanentDistrict     String?
  permanentMunicipality String?
  permanentWardNo       String?
  permanentAddress      String?
  temporaryProvince     String?
  temporaryDistrict     String?
  temporaryMunicipality String?
  temporaryWardNo       String?
  temporaryAddress      String?
  passportNumber        String?
  passportNationality   String?
  passportIssueDate     String?
  passportExpiryDate    String?
  passportIssuePlace    String?
  education             String?
  workExperience        String?
  training              String?
  testType              String?
  overallScore          String?
  readingScore          String?
  writingScore          String?
  listeningScore        String?
  speakingScore         String?
  moi                   String?
  testDate              String?
  testRegNumber         String?
  studyLevel            String?
  intakeTerm            String?
  major                 String?
  interestedCountry     String?
  targetUniversities    String?
  spouseName            String?
  childrenDetails       String?           @default("[]")
  guardianName          String?
  guardianPhone         String?
  guardianEmail         String?
  guardianRelation      String?
  guardianAddress       String?
  status                String            @default("New Leads")
  statusColor           String?
  initials              String?
  color                 String?
  university            String?
  country               String?
  lastActivity          String?
  counselor             String?
  lead                  String?
  branchId              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  applications          Application[]
  payments              Payment[]
  documents             StudentDocument[]
}

model Application {
  id           String     @id @default(cuid())
  studentId    String
  universityId String
  courseId     String
  status       String     @default("Submitted")
  appliedDate  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([universityId])
  @@index([courseId])
}

model StudentDocument {
  id         String   @id @default(cuid())
  studentId  String
  type       String?
  name       String
  url        String
  status     String?  @default("Uploaded")
  fileSize   Int?
  fileType   String?
  uploadedAt DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Qualification {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  studentId   String
  amount      Float
  currency    String   @default("NPR")
  status      String   @default("Pending")
  method      String?
  date        DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  proofUrl    String?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model Expense {
  id            String   @id @default(cuid())
  category      String
  amount        Float
  currency      String   @default("NPR")
  date          DateTime @default(now())
  description   String?
  paidTo        String?
  method        String?
  billNo        String?
  transactionNo String?
  screenshot    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("Todo")
  priority    String    @default("Medium")
  dueDate     DateTime?
  type        String    @default("Manual")
  country     String?
  visaType    String?
  assigneeId  String?
  branchId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch?   @relation(fields: [branchId], references: [id])
  assignee    User?     @relation(fields: [assigneeId], references: [id])
}

model Country {
  id        String             @id @default(cuid())
  name      String             @unique
  code      String?
  createdAt DateTime           @default(now())
  resources LearningResource[]
}

model LearningCategory {
  id        String             @id @default(cuid())
  name      String             @unique
  createdAt DateTime           @default(now())
  resources LearningResource[]
}

model LearningResource {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        String            @default("Document")
  url         String
  thumbnail   String?
  fileSize    String?
  countryId   String?
  categoryId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    LearningCategory? @relation(fields: [categoryId], references: [id])
  country     Country?          @relation(fields: [countryId], references: [id])
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   @default("Technical") // Technical (Bug) or Feature Request
  priority    String   @default("Medium") // Low, Medium, High, Urgent
  status      String   @default("Open") // Open, In Progress, Resolved, Closed
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  screenshot  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
}

model VisaType {
  id          String   @id @default(cuid())
  label       String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model EmbassyDetail {
  id          String   @id @default(cuid())
  country     String
  visaType    String
  name        String
  address     String?
  phone       String?
  email       String?
  website     String?
  workingHours String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisaChecklist {
  id          String   @id @default(cuid())
  country     String
  visaType    String
  title       String
  description String?
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowStage {
  id          String   @id @default(cuid())
  country     String
  visaType    String
  name        String
  order       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  headId      String?  @unique
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     User[]
}

model Designation {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     User[]
}

model EmployeeDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String?
  name      String
  url       String
  status    String   @default("Uploaded")
  fileSize  Int?
  fileType  String?
  createdAt DateTime @default(now())
}

model Attendance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  status        String   @default("Present")
  notes         String?
  checkInPhoto  String?
  checkOutPhoto String?
  checkInLat    Float?
  checkInLng    Float?
  checkOutLat   Float?
  checkOutLng   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model LeaveType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  daysPerYear Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  balances    LeaveBalance[]
  requests    LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  totalDays   Int       @default(0)
  usedDays    Int       @default(0)
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("Pending")
  approvedBy  String?
  approver    User?     @relation("ApprovedLeaves", fields: [approvedBy], references: [id])
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Payroll {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  basicSalary   Float          @default(0)
  allowances    Float          @default(0)
  deductions    Float          @default(0)
  bonus         Float          @default(0)
  netSalary     Float          @default(0)
  status        String         @default("Draft")
  paidAt        DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PayrollItem[]

  @@unique([userId, month, year])
  @@index([userId])
  @@index([month, year])
}

model PayrollItem {
  id        String   @id @default(cuid())
  payrollId String
  payroll   Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  label     String
  type      String
  amount    Float    @default(0)
  createdAt DateTime @default(now())

  @@index([payrollId])
}

model ScannedDocument {
  id         String   @id @default(cuid())
  userId     String
  filename   String
  url        String
  fileSize   Int
  dpi        Int      @default(200)
  pageCount  Int      @default(1)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model FileFolder {
  id        String     @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  files     FileItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FileItem {
  id        String     @id @default(cuid())
  name      String
  url       String
  fileSize  Int        @default(0)
  fileType  String     @default("application/octet-stream")
  folderId  String
  userId    String
  createdAt DateTime   @default(now())
  folder    FileFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([userId])
}

model ChatRoom {
  id        String        @id @default(cuid())
  name      String?
  type      String        @default("DIRECT")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  members   User[]        @relation("ChatRoomMembers")
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
}
