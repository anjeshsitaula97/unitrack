# Database
DATABASE_URL="mysql://user:password@localhost:3306/unitrack"

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=""

# Master API
MASTER_API_URL="http://localhost:5000"
MASTER_API_KEY=""

# App base URL — used for gateway success/failure redirects and CSRF checks
NEXT_PUBLIC_APP_URL="http://localhost:4028"

# Checkout — eSewa ePay v2
# UAT sandbox: ESEWA_MODE="uat", PRODUCT_CODE="EPAYTEST", SECRET_KEY="8gBm/:&EnhH.1/q"
# Production: set ESEWA_MODE="production" and use the live merchant product code + secret key.
ESEWA_MODE="uat"
ESEWA_PRODUCT_CODE=""
ESEWA_SECRET_KEY=""

# Checkout — NCHL connectIPS (credentials are issued during NCHL onboarding;
# the connectIPS option stays disabled until all of these are set)
# CONNECTIPS_PFX_PATH — path to the CREDITOR.pfx certificate file, or
# CONNECTIPS_PFX_BASE64 — the same file base64 encoded (e.g. for container deploys)
CONNECTIPS_MODE="test"
CONNECTIPS_MERCHANT_ID=""
CONNECTIPS_APP_ID=""
CONNECTIPS_APP_NAME="UniTrack"
CONNECTIPS_APP_PASSWORD=""
CONNECTIPS_PFX_PATH=""
CONNECTIPS_PFX_BASE64=""
CONNECTIPS_PFX_PASSWORD=""

# Optional
# NODE_ENV="development"

# Persistent upload storage directory (absolute path recommended in production)
UPLOADS_DIR=
