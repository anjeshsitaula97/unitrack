# Node modules
node_modules/
# NOTE: package-lock.json is intentionally tracked — reproducible installs and
# `npm ci` in CI depend on it. Do not add it back to this ignore list.

# Next.js build output
.next/
.next-build/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# macOS AppleDouble metadata files (exFAT volumes)
._*

# Local database files
# The app connects to the DATABASE_URL server (MySQL in .env.example); a
# checked-in SQLite file would silently shadow real data for anyone cloning.
prisma/*.db
prisma/*.db-journal
prisma/*.sqlite
prisma/*.sqlite3

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Uploaded files
public/uploads/

# Optional: if using TurboRepo or monorepo
turbo/
/src/generated/prisma

# Environment variables
# NOTE: .env.example is intentionally tracked as the documented template.
# Every other .env* file must stay untracked - gitignore does NOT apply to files
# that are already tracked, so `git rm --cached` them if they were ever added.
.env
.env.*
!.env.example
.env.local
.env.*.local
.env.production
.env.development
# Per-box deploy config for scripts/deploy.sh (branch, restart command)
/.deploy.env

# Dev artifacts (persistent upload storage survives deploys, served via /api/uploads)
*.log
/storage/
*.txt
out.txt
tmp_users.json
api_output.json
scratch/
.stitch/

# One-off analysis output and tooling directories (not part of the app)
# NOTE: /data/nepal and /scanner-agent are intentionally TRACKED:
#   - /api/nepal/* routes read data/nepal/*.json from process.cwd() at runtime
#   - the Files page instructs users to run `node scanner-agent/index.js`
#   Untracking either breaks fresh clones / production. Do not ignore them.
/graphify-out/
/Technologies/
/.opencode/
/.qoder/